# Copy to .env in voice-agent; replace placeholders with isolated service values.
# server.py and bot.py load this file with override=True from the working directory.

# NLTK uses its standard user data location for the host setup in docs/LOCAL_SETUP.md.
# For a custom data directory, export NLTK_DATA in the shell before starting Python.
# This file is loaded after NLTK imports; an entry here alone cannot configure it.
# NLTK_DATA=/absolute/path/to/nltk_data

# Daily credentials for development room creation and PSTN dial-in.
DAILY_API_KEY=

# Speech-to-text / text-to-speech / LLM service credentials.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=

# Local routing: bot.py listens on 7860; server.py listens on 8080.
LOCAL_BOT_URL=http://localhost:7860
LOCAL_SERVER_URL=http://localhost:8080
# 0 skips room creation during server startup; webhooks still create rooms.
# Set to 1 or more after configuring Daily development credentials.
ROOM_POOL_SIZE=0
# PORT is optional and process-specific. Leave unset here for distinct defaults.
# For example, PORT=8080 for server.py or PORT=7860 for bot.py, never both.

# Supabase load/stops, call records, organization lookup and recording storage.
# Use the same isolated project as web/.env.local. Replace the placeholder key.
# The URL below is for a local Supabase instance; use its actual API URL if different.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-isolated-service-role-key

# Highway MC lookup: ask the maintainer for an authorized development endpoint/key.
# This placeholder deliberately cannot reach a production carrier service.
HIGHWAY_API_BASE_URL=https://carrier-test.example.invalid
HIGHWAY_API_KEY=
HIGHWAY_PHONE_LOOKUP_TIMEOUT_S=1.5
HIGHWAY_PHONE_LOOKUP_ENABLED=false
# highway selects the existing configurable MC path. carrier_api and all DOT
# lookups use the historical external production carrier service; see Local setup.
CARRIER_MC_BACKEND=highway

# Accepted-quote submission through KCH. Credentials and scope must belong together.
KCH_QUOTE_CLIENT_ID=
KCH_QUOTE_CLIENT_SECRET=
KCH_QUOTE_SCOPE=
# This selects the quote sandbox only; other integrations need separate test access.
KCH_QUOTE_USE_SANDBOX=true

# Required by the broker-transfer notification step. Use a development channel.
SLACK_WEBHOOK_URL=
