# Copy to .env in voice-agent; replace placeholders with isolated service values.
# server.py and bot.py load this file with override=True from the working directory.

# NLTK uses its standard user data location for the host setup in docs/LOCAL_SETUP.md.
# For a custom directory, export NLTK_DATA before Python starts; this file loads
# after imports which initialize NLTK.
# NLTK_DATA=/absolute/path/to/nltk_data

# LiveKit project credentials and Telnyx-backed SIP resources.
# Use a development LiveKit project. Never commit real API secrets.
LIVEKIT_URL=wss://replace-with-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Copy the exact ST_/SDR_ identifiers from the LiveKit project.
LIVEKIT_SIP_INBOUND_TRUNK_ID=
LIVEKIT_SIP_DISPATCH_RULE_ID=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
# E.164 caller ID owned by the outbound Telnyx/LiveKit trunk.
LIVEKIT_SIP_OUTBOUND_NUMBER=+12025550199
# Prefix for rooms created by the application.
LIVEKIT_ROOM_PREFIX=negotiation
# Maximum wait for the separate hold publisher to join the carrier room.
LIVEKIT_TRANSFER_HOLD_CONNECT_TIMEOUT_SECONDS=10
# Maximum time for the broker's outbound SIP leg to answer and join Room2.
LIVEKIT_TRANSFER_BROKER_TIMEOUT_SECONDS=45
# Maximum time for the bot and broker to consult while the carrier is on hold.
LIVEKIT_TRANSFER_CONSULTATION_TIMEOUT_SECONDS=180
# Total reconciliation window for moving the broker from Room2 to Room1.
LIVEKIT_TRANSFER_ARRIVAL_TIMEOUT_SECONDS=10

# Local routing: bot.py listens on 7860; server.py listens on 8080.
LOCAL_BOT_URL=http://localhost:7860
# Required by POST /outbound-call through the X-API-Key request header.
# Generate a development-only secret; leaving this empty disables authorized calls.
OUTBOUND_CALL_API_KEY=
# PORT is optional and process-specific. Leave unset here for distinct defaults.
# For example, PORT=8080 for server.py or PORT=7860 for bot.py, never both.

# Speech-to-text / text-to-speech / LLM service credentials.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=

# Supabase load/stops, call records, organization lookup, and recording storage.
# Use the same isolated project as web/.env.local. Replace the placeholder key.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-isolated-service-role-key

# Highway MC lookup: ask the maintainer for an authorized development endpoint/key.
# This placeholder deliberately cannot reach a production carrier service.
HIGHWAY_API_BASE_URL=https://carrier-test.example.invalid
HIGHWAY_API_KEY=
HIGHWAY_PHONE_LOOKUP_TIMEOUT_S=1.5
HIGHWAY_PHONE_LOOKUP_ENABLED=false
# highway selects the configurable MC path. carrier_api and all DOT lookups use
# the historical external carrier service; see docs/LOCAL_SETUP.md.
CARRIER_MC_BACKEND=highway

# Accepted-quote submission through KCH. Credentials and scope must belong together.
KCH_QUOTE_CLIENT_ID=
KCH_QUOTE_CLIENT_SECRET=
KCH_QUOTE_SCOPE=
# This selects the quote sandbox only; other integrations need separate test access.
KCH_QUOTE_USE_SANDBOX=true

# Required by the broker-transfer notification step. Use a development channel.
SLACK_WEBHOOK_URL=
