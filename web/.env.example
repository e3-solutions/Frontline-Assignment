# Copy to .env.local for the web app, using the same isolated project as voice.
# Use the actual API URL and anon key from that project; placeholders cannot log in.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-isolated-anon-key
# Server credentials must match that project. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-isolated-service-role-key
# Optional runtime overrides for the same project's URL/public anon key.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=replace-with-isolated-anon-key
# SHA-256 hash of a development registration code; see web/README.md to generate it.
# Leaving this empty permits unrestricted company registration.
COMPANY_REGISTRATION_SECRET_HASH=replace-with-sha256-hash
# Displayed development LiveKit SIP number. Replace the reserved example number.
NEXT_PUBLIC_AGENT_PHONE_NUMBER=+15555550100
NEXT_PUBLIC_ENVIRONMENT=local

# Export NODE_AUTH_TOKEN separately in the shell before npm ci; see web/README.md.
# It requires GitHub Packages read access to the existing @e3-solutions/ui package.
# NODE_AUTH_TOKEN=replace-with-authorized-package-read-token
